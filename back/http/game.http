# GameLog - Game API (검색 · 목록 · 필터)
# IntelliJ IDEA HTTP Client에서 http-client.env.json의 local 환경을 선택한 뒤 사용합니다.
# 모두 로그인 없이 호출할 수 있는 공개 API입니다.

###
# @name 1. 게임 검색어 자동완성
GET {{baseUrl}}/api/v1/games/suggestions?keyword=Baldur

###
# @name 1-1. 게임 검색어 자동완성 - 검색어 없음
# keyword가 없어도 오류 없이 응답해야 합니다.
GET {{baseUrl}}/api/v1/games/suggestions

###
# @name 2. 게임 목록 조회 - 기본값
# page=0, size=20, 정렬 미지정 시 IGDB 평점 내림차순입니다.
GET {{baseUrl}}/api/v1/games/page

###
# @name 2-1. 게임 목록 조회 - 검색어와 정렬
# sort: LATEST, TITLE, RATING, LIBRARY, PLAY_TIME
GET {{baseUrl}}/api/v1/games/page?keyword=Baldur&sort=LATEST&page=0&size=20

###
# @name 2-2. 게임 목록 조회 - 장르·플랫폼 필터
# genreIds, platformIds는 3번 필터 목록 조회로 확인한 ID로 바꿔주세요.
# 같은 종류 안에서는 OR, 장르와 플랫폼 사이는 AND로 적용됩니다.
GET {{baseUrl}}/api/v1/games/page?genreIds=12&genreIds=31&platformIds=6&page=0&size=20

###
# @name 2-3. [검증] 게임 목록 조회 - 페이지 크기 초과
# size가 최대 100을 초과하므로 400-1 응답이 반환되어야 합니다.
GET {{baseUrl}}/api/v1/games/page?page=0&size=101

###
# @name 2-4. [검증] 게임 목록 조회 - 잘못된 정렬 값
# 존재하지 않는 sort 값이므로 400-1 응답이 반환되어야 합니다.
GET {{baseUrl}}/api/v1/games/page?sort=WRONG

###
# @name 3. 게임 필터 목록 조회
# 목록 조회에 사용할 장르·플랫폼 ID 목록을 반환합니다.
GET {{baseUrl}}/api/v1/games/filters
