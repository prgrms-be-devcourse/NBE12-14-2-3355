# GameLog API - 통합 HTTP Client
# IntelliJ IDEA HTTP Client에서 http-client.env.json의 local 환경을 선택한 뒤 사용합니다.
# 기존 도메인별 .http 파일은 유지하며, 이 파일은 전체 요청을 한곳에서 실행하기 위한 통합본입니다.


# ============================================================================
# 인증 · 회원 · 라이브러리 · 이미지
# 원본: back/postman/Gamelog-http.http
# ============================================================================

# Gamelog - User Auth Copy

###
# @name 1. 회원가입
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "nickname": "테스트",
  "email": "test@test.com",
  "password": "12345678"
}

###
# @name 2. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "test@test.com",
  "password": "12345678"
}

> {%
    if (response.status === 200) {
        const res = response.body;
        client.global.set("accessToken", res.data.accessToken);
        console.log("accessToken 저장됨:", res.data.accessToken);
    } else {
        console.log("로그인 실패:", response.body);
    }
%}

###
# @name 3. 토큰 재발급
# refreshToken 쿠키가 자동으로 전송됩니다 (2번 로그인 요청을 먼저 실행해서 쿠키가 저장되어 있어야 함). Postman 쿠키 자동 전송 설정이 켜져 있어야 합니다.
POST {{baseUrl}}/api/v1/users/refresh

> {%
    if (response.status === 200) {
        const res = response.body;
        client.global.set("accessToken", res.data.accessToken);
        console.log("accessToken 갱신됨:", res.data.accessToken);
    } else {
        console.log("재발급 실패:", response.body);
    }
%}

###
# @name 4. 내 정보 조회
GET {{baseUrl}}/api/v1/users/me
Authorization: Bearer {{accessToken}}


###
# @name 4-1. 내 정보 업데이트
PATCH {{baseUrl}}/api/v1/users/me
    Authorization: Bearer {{accessToken}}
    Content-Type: application/json

  {
    "nickname": "새닉네임",
    "profileImageUrl": "https://example.com/profile.png",
    "bio": "안녕하세요"
  }

###
# @name 5. 온보딩 완료
PATCH {{baseUrl}}/api/v1/users/me/onboarding
Authorization: Bearer {{accessToken}}

###
# @name 6. 온보딩 건너뛰기
PATCH {{baseUrl}}/api/v1/users/me/onboarding/skip
Authorization: Bearer {{accessToken}}

###
# @name 7. 선호 장르 저장
# genreIds는 사람마다 로컬 DB 상태가 달라서 공용 값이 없습니다. 아래 SQL로 본인 DB에서 확인 후 채우세요.
#   SELECT id, name FROM genres LIMIT 5;
# (장르 목록 조회 API는 아직 없음)
PUT {{baseUrl}}/api/v1/users/me/preferred-genres
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "genreIds": []
}

###
# @name 7-1. [검증] 선호 장르 저장 실패 - 최대 3개 초과
# genreIds 4개 넣으면 400-2("최대 3개까지 선택 가능") 응답이 와야 합니다. id 실존 여부는 상관없음(개수 체크가 먼저 걸림).
PUT {{baseUrl}}/api/v1/users/me/preferred-genres
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "genreIds": [1,2,3,4]
}

###
# @name 7-2. [검증] 선호 장르 저장 실패 - 인증 없이 호출
# Authorization 헤더 없이 호출하면 401-1("로그인이 필요합니다.")이 와야 합니다.
PUT {{baseUrl}}/api/v1/users/me/preferred-genres
Content-Type: application/json

{
  "genreIds": [1]
}

###
# @name 8. 선호 장르 조회
GET {{baseUrl}}/api/v1/users/me/preferred-genres
Authorization: Bearer {{accessToken}}

###
# @name 9. 선호 게임 저장
# gameIds도 사람마다 로컬 DB 상태가 달라서 공용 값이 없습니다. 아래 SQL로 본인 DB에서 확인 후 채우세요.
#   SELECT id, title FROM games LIMIT 5;
# 또는 GET /api/v1/games/page 로 조회해도 됩니다.
PUT {{baseUrl}}/api/v1/users/me/preferred-games
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "gameIds": []
}

###
# @name 9-1. [검증] 선호 게임 저장 실패 - 최대 3개 초과
PUT {{baseUrl}}/api/v1/users/me/preferred-games
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "gameIds": []
}

###
# @name 10. 선호 게임 조회
GET {{baseUrl}}/api/v1/users/me/preferred-games
Authorization: Bearer {{accessToken}}

###
# @name 11. 중복 이메일
GET {{baseUrl}}/api/v1/users/check-email?email=test@test.com

###
# @name 12. 중복 닉네임
GET {{baseUrl}}/api/v1/users/check-nickname?nickname=테스트

###
# @name 게임 정보
GET {{baseUrl}}/api/v1/games/1

### 라이브러리 api
###
# @name 게임 기록 목록
GET {{baseUrl}}/api/v1/library/games
Authorization: Bearer {{accessToken}}

###
# @name 라이브러리에 추가
POST {{baseUrl}}/api/v1/library/games/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "playStatus": "COMPLETED",
  "isPlaying": true,
  "isBacklog": false,
  "isWishlist": true,
  "isLiked": true,
  "platformId": 1,
  "playTimeHours": 12.5,
  "finishTimeHours": 25.0,
  "masterTimeHours": 50.0,
  "startedAt": "2026-09-01",
  "completedAt": "2026-09-15",
  "lastPlayedAt": "2026-09-15T21:30:00"
}

###
# @name 게임 기록 수정
PATCH {{baseUrl}}/api/v1/library/games/1?userId=1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "playStatus": "PLAYED",
  "isPlaying": false,
  "isBacklog": false,
  "isWishlist": false,
  "isLiked": false,
  "platformId": 1,
  "playTimeHours": 100.5,
  "finishTimeHours": 35.0,
  "masterTimeHours": 80.0,
  "startedAt": "2026-08-01",
  "completedAt": "2026-08-20",
  "lastPlayedAt": "2026-08-20T21:30:00"
}

###
# @name 플레이 상태 변경
PUT {{baseUrl}}/api/v1/library/games/1/play-status?status=PLAYED
Authorization: Bearer {{accessToken}}
Content-Type: application/x-www-form-urlencoded

###
# @name 플레이 중 변경
PATCH {{baseUrl}}/api/v1/library/games/1/playing?playing=true
Authorization: Bearer {{accessToken}}
Content-Type: application/x-www-form-urlencoded

###
# @name 위시리스트 변경
PATCH {{baseUrl}}/api/v1/library/games/1/wishlist?wishlist=false
Authorization: Bearer {{accessToken}}
Content-Type: application/x-www-form-urlencoded

###
# @name 백로그 변경
PATCH {{baseUrl}}/api/v1/library/games/1/backlog?backlog=true
Authorization: Bearer {{accessToken}}
Content-Type: application/x-www-form-urlencoded

###
# @name 좋아요 변경
PATCH {{baseUrl}}/api/v1/library/games/1/liked?liked=true
Authorization: Bearer {{accessToken}}
Content-Type: application/x-www-form-urlencoded

###
# @name 프로필 탭
GET {{baseUrl}}/api/v1/library/games/profile
Authorization: Bearer {{accessToken}}

###
# @name 타인 프로필 탭
GET {{baseUrl}}/api/v1/library/games/profile/6
Authorization: Bearer {{accessToken}}

###
# @name 인생게임 수정
PUT {{baseUrl}}/api/v1/library/games/favorite-games
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "gameIds": [2, 1]
}

### 이미지 업로드 api
###
# @name 이미지 업로드
POST {{baseUrl}}/api/v1/uploads/images
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="test.jpg"
Content-Type: image/jpeg

< ./test.jpg
--WebAppBoundary--


# ============================================================================
# 게임 상세 · 추천
# 원본: back/postman/game-detail.http
# ============================================================================

# Gamelog - Game Detail & Recommendation API
# IntelliJ IDEA HTTP Client에서 각 요청 왼쪽의 실행 버튼(▶)을 눌러 테스트합니다.

@gameId = 6
@invalidGameId = 9999999


###
# @name getGameDetail
# 1. Gamelog 게임 상세 정보 조회
# GameLog DB ID를 기준으로 게임의 상세 정보를 조회합니다.
GET {{baseUrl}}/api/v1/games/{{gameId}}


###
# @name getRelatedGames
# 2. Gamelog 연관 추천 게임 상위 5개 조회
# GameLog DB ID를 기준으로 알고리즘 추천 상위 5개 게임 목록을 조회합니다.
GET {{baseUrl}}/api/v1/games/{{gameId}}/related


###
# @name getGameDetailNotFound
# 3. [실패 검증] 존재하지 않는 게임 상세 조회 시 404 응답
GET {{baseUrl}}/api/v1/games/{{invalidGameId}}


###
# @name getRelatedGamesNotFound
# 4. [실패 검증] 존재하지 않는 게임의 연관 추천 조회 시 404 응답
GET {{baseUrl}}/api/v1/games/{{invalidGameId}}/related


###
# @name loginForPersonalizedRecommendations
# 5. 맞춤 추천 API 테스트용 로그인
# 로그인 성공 시 accessToken을 HTTP Client 전역 변수에 저장합니다.
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "test1@test.com",
  "password": "12345678"
}

> {%
    if (response.status === 200) {
        client.global.set(
            "accessToken",
            response.body.data.accessToken
        );
        client.log("accessToken 저장 완료");
    } else {
        client.log("로그인 실패: " + response.status);
    }
%}


###
# @name getPersonalizedGameRecommendations
# 6. 로그인 사용자의 게임 기록 또는 온보딩 선택을 기준으로 맞춤 추천 게임 조회
# 위의 로그인 요청을 먼저 실행해 accessToken을 저장해야 합니다.
GET {{baseUrl}}/api/v1/games/recommendations/personalized
Authorization: Bearer {{accessToken}}


###
# @name getPersonalizedGameRecommendationsUnauthorized
# 7. [실패 검증] 인증 토큰 없이 맞춤 추천 게임 조회 시 401 응답
GET {{baseUrl}}/api/v1/games/recommendations/personalized


# ============================================================================
# 인기 콘텐츠
# 원본: back/postman/popular-content.http
# ============================================================================

# GameLog Popular Content API
# 메인 화면의 Popular Games와 Popular Reviews 공개 API를 테스트합니다.



# Popular Games


###
# @name getPopularGames
# 1. Popular Games 기본 5개 조회
# 인증 헤더 없이 조회할 수 있어야 합니다.
GET {{baseUrl}}/api/v1/games/popular


###
# @name getPopularGamesWithSize
# 2. Popular Games 조회 개수 지정
GET {{baseUrl}}/api/v1/games/popular?size=3

###
# @name getPopularGamesWithMinimumSize
# 3. Popular Games 최소 허용 개수 조회
GET {{baseUrl}}/api/v1/games/popular?size=1


###
# @name getPopularGamesWithMaximumSize
# 4. Popular Games 최대 허용 개수 조회
GET {{baseUrl}}/api/v1/games/popular?size=50


###
# @name getPopularGamesWithZeroSize
# 5. [실패 검증] 조회 개수가 0이면 400-9 응답
GET {{baseUrl}}/api/v1/games/popular?size=0


###
# @name getPopularGamesOverMaximumSize
# 6. [실패 검증] 조회 개수가 50을 초과하면 400-9 응답
GET {{baseUrl}}/api/v1/games/popular?size=51


# Popular Reviews


###
# @name getPopularReviews
# 1. Popular Reviews 기본 5개 조회
# 인증 헤더 없이 조회할 수 있어야 합니다.
GET {{baseUrl}}/api/v1/reviews/popular


###
# @name getPopularReviewsWithSize
# 2. Popular Reviews 조회 개수 지정
GET {{baseUrl}}/api/v1/reviews/popular?size=3


###
# @name getPopularReviewsWithMinimumSize
# 3. Popular Reviews 최소 허용 개수 조회
GET {{baseUrl}}/api/v1/reviews/popular?size=1


###
# @name getPopularReviewsWithMaximumSize
# 4. Popular Reviews 최대 허용 개수 조회
GET {{baseUrl}}/api/v1/reviews/popular?size=50


###
# @name getPopularReviewsWithZeroSize
# 5. [실패 검증] 조회 개수가 0이면 400-10 응답
GET {{baseUrl}}/api/v1/reviews/popular?size=0


###
# @name getPopularReviewsOverMaximumSize
# 6. [실패 검증] 조회 개수가 50을 초과하면 400-10 응답
GET {{baseUrl}}/api/v1/reviews/popular?size=51


# ============================================================================
# 리뷰
# 원본: back/postman/review.http
# ============================================================================

# GameLog - Review API
# IntelliJ IDEA HTTP Client에서 각 요청 왼쪽의 실행 버튼을 눌러 테스트합니다.
# 위에서 아래 순서대로 실행하면 accessToken, userGameId, reviewId가 자동 저장됩니다.

@gameId = 6
@userId = 1
@email = librarytest222222@test.com
@password = test1234!

###
# @name login
# 1. 로그인 및 accessToken 자동 저장
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    if (response.status === 200) {
        client.global.set("accessToken", response.body.data.accessToken);
        client.log("accessToken 저장 완료");
    } else {
        client.log("로그인 실패: " + response.status);
    }
%}

###
# @name getMyDetailedReviewBeforeSave
# 2. 내 게임 기록·상세 리뷰 조회
# 처음 저장하는 게임이라면 userGame과 review가 모두 null일 수 있습니다.
GET {{baseUrl}}/api/v1/games/{{gameId}}/reviews/me
Authorization: Bearer {{accessToken}}

###
# @name saveDetailedReview
# 3. 게임 기록과 리뷰 통합 저장
# 성공하면 이후 테스트에서 사용할 userGameId와 reviewId를 자동 저장합니다.
PUT {{baseUrl}}/api/v1/games/{{gameId}}/reviews
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "userGame": {
    "playStatus": "PLAYED",
    "isPlaying": false,
    "isBacklog": false,
    "isWishlist": false,
    "isLiked": true,
    "platformId": null,
    "playTimeHours": 42.5,
    "finishTimeHours": 35.0,
    "masterTimeHours": 80.0,
    "startedAt": "2026-08-01",
    "completedAt": "2026-08-20",
    "lastPlayedAt": "2026-08-20T21:30:00"
  },
  "review": {
    "rating": 4.5,
    "content": "상세 리뷰 저장 테스트입니다.",
    "spoiler": false
  }
}

> {%
    if (response.status === 200) {
        client.global.set("userGameId", response.body.data.userGame.id);
        if (response.body.data.review !== null) {
            client.global.set("reviewId", response.body.data.review.reviewId);
        }
        client.log("userGameId/reviewId 저장 완료");
    }
%}

###
# @name getMyDetailedReviewAfterSave
# 4. 저장한 내 게임 기록·리뷰 확인
GET {{baseUrl}}/api/v1/games/{{gameId}}/reviews/me
Authorization: Bearer {{accessToken}}

###
# @name getGameReviews
# 5. 게임별 공개 리뷰 목록 조회
# 비로그인 요청이며 최신 작성순으로 조회합니다.
GET {{baseUrl}}/api/v1/games/{{gameId}}/reviews?page=0&size=20&sort=createdDate,desc

###
# @name getReview
# 6. 리뷰 단건 조회
GET {{baseUrl}}/api/v1/reviews/{{reviewId}}

###
# @name updateReview
# 7. 리뷰 ID로 별점·내용 수정
PUT {{baseUrl}}/api/v1/reviews/{{reviewId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "rating": 3.5,
  "content": "리뷰 내용을 수정했습니다.",
  "spoiler": true
}

###
# @name saveReviewByUserGame
# 8. UserGame ID로 리뷰 저장·수정
PUT {{baseUrl}}/api/v1/user-games/{{userGameId}}/reviews
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "rating": 4.0,
  "content": "게임 기록에 연결된 리뷰입니다.",
  "spoiler": false
}

###
# @name getUserReviews
# 9. 사용자별 리뷰 목록 조회
# userId는 파일 상단에서 실제 로그인 사용자 ID로 맞춰주세요.
GET {{baseUrl}}/api/v1/users/{{userId}}/reviews?page=0&size=20&sort=createdDate,desc

###
# @name getLikeCountWithoutLogin
# 10. 비로그인 상태에서 리뷰 좋아요 수 조회
GET {{baseUrl}}/api/v1/reviews/{{reviewId}}/likes/count

###
# @name addReviewLike
# 11. 리뷰 좋아요 등록
POST {{baseUrl}}/api/v1/reviews/{{reviewId}}/likes
Authorization: Bearer {{accessToken}}

###
# @name getLikeStatusWithLogin
# 12. 로그인 사용자의 좋아요 여부와 전체 개수 조회
GET {{baseUrl}}/api/v1/reviews/{{reviewId}}/likes/count
Authorization: Bearer {{accessToken}}

###
# @name removeReviewLike
# 13. 리뷰 좋아요 취소
DELETE {{baseUrl}}/api/v1/reviews/{{reviewId}}/likes
Authorization: Bearer {{accessToken}}

###
# @name saveGameRecordOnly
# 14. 리뷰 없이 게임 기록만 저장
# 기존 리뷰가 있다면 삭제하지 않고 그대로 유지됩니다.
PUT {{baseUrl}}/api/v1/games/{{gameId}}/reviews
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "userGame": {
    "playStatus": null,
    "isPlaying": false,
    "isBacklog": true,
    "isWishlist": false,
    "isLiked": false,
    "platformId": null,
    "playTimeHours": null,
    "finishTimeHours": null,
    "masterTimeHours": null,
    "startedAt": null,
    "completedAt": null,
    "lastPlayedAt": null
  },
  "review": null
}

###
# @name saveEmptyReviewAsGameRecordOnly
# 15. 프론트가 빈 리뷰 객체를 보내도 게임 기록만 저장
# rating과 content가 비어 있으므로 새 빈 리뷰는 생성하지 않습니다.
PUT {{baseUrl}}/api/v1/games/{{gameId}}/reviews
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "userGame": {
    "playStatus": null,
    "isPlaying": false,
    "isBacklog": true,
    "isWishlist": false,
    "isLiked": false,
    "platformId": null,
    "playTimeHours": null,
    "finishTimeHours": null,
    "masterTimeHours": null,
    "startedAt": null,
    "completedAt": null,
    "lastPlayedAt": null
  },
  "review": {
    "rating": null,
    "content": "",
    "spoiler": false
  }
}

###
# @name rejectInvalidRating
# 16. [실패 검증] 0.5 단위가 아닌 별점은 400 응답
PUT {{baseUrl}}/api/v1/reviews/{{reviewId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "rating": 4.3,
  "content": "잘못된 별점 검증",
  "spoiler": false
}

###
# @name rejectEmptyReviewOnlyRequest
# 17. [실패 검증] 리뷰 단독 API에서는 별점과 내용이 모두 비어 있으면 400 응답
PUT {{baseUrl}}/api/v1/reviews/{{reviewId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "rating": null,
  "content": "",
  "spoiler": false
}

###
# @name deleteReview
# 18. 리뷰 삭제 - 마지막에 실행하세요.
DELETE {{baseUrl}}/api/v1/reviews/{{reviewId}}
Authorization: Bearer {{accessToken}}


# ============================================================================
# 팔로우
# 원본: back/postman/user-follow.http
# ============================================================================

# GameLog Following / Followers API

# 본인 로컬 DB에 존재하는 사용자 정보로 수정하세요.
@loginEmail = test4@test.com
@loginPassword = 12345678

# profileUserId: Following / Followers 목록을 조회할 사용자
# followTargetUserId: 로그인 사용자가 팔로우할 대상 사용자
@profileUserId = 4
@followTargetUserId = 2

###
# @name 1. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "{{loginEmail}}",
  "password": "{{loginPassword}}"
}

> {%
    if (response.status === 200) {
        const res = response.body;
        client.global.set("accessToken", res.data.accessToken);
        console.log("accessToken 저장됨:", res.data.accessToken);
    } else {
        console.log("로그인 실패:", response.body);
    }
%}

###
# @name 2. 사용자 팔로우
PUT {{baseUrl}}/api/v1/users/me/following/{{followTargetUserId}}
Authorization: Bearer {{accessToken}}

###
# @name 2-1. 동일 사용자 중복 팔로우
# 이미 팔로우 중이어도 중복 관계를 생성하지 않고 followed=true를 반환해야 합니다.
PUT {{baseUrl}}/api/v1/users/me/following/{{followTargetUserId}}
Authorization: Bearer {{accessToken}}

###
# @name 3. Following 목록 공개 조회
# 인증 헤더 없이 조회할 수 있어야 합니다.
# 비로그인 상태이므로 followedByMe와 me는 false입니다.
GET {{baseUrl}}/api/v1/users/{{profileUserId}}/following?page=0&size=10

###
# @name 3-1. Following 목록 로그인 조회
# 로그인 사용자를 기준으로 followedByMe와 me를 확인합니다.
GET {{baseUrl}}/api/v1/users/{{profileUserId}}/following?page=0&size=10
Authorization: Bearer {{accessToken}}

###
# @name 4. Followers 목록 공개 조회
# 인증 헤더 없이 조회할 수 있어야 합니다.
# 비로그인 상태이므로 followedByMe와 me는 false입니다.
GET {{baseUrl}}/api/v1/users/{{profileUserId}}/followers?page=0&size=10

###
# @name 4-1. Followers 목록 로그인 조회
# 로그인 사용자를 기준으로 followedByMe와 me를 확인합니다.
GET {{baseUrl}}/api/v1/users/{{profileUserId}}/followers?page=0&size=10
Authorization: Bearer {{accessToken}}

###
# @name 5. 사용자 언팔로우
DELETE {{baseUrl}}/api/v1/users/me/following/{{followTargetUserId}}
Authorization: Bearer {{accessToken}}

###
# @name 5-1. 관계가 없는 사용자 언팔로우
# 이미 관계가 없어도 followed=false를 반환해야 합니다.
DELETE {{baseUrl}}/api/v1/users/me/following/{{followTargetUserId}}
Authorization: Bearer {{accessToken}}

###
# @name 6. 사용자 팔로우 실패 - 인증 없음
# 401-1 응답이 반환되어야 합니다.
PUT {{baseUrl}}/api/v1/users/me/following/{{followTargetUserId}}

###
# @name 7. Following 목록 조회 실패 - 잘못된 페이지
# page가 0보다 작으므로 400-7 응답이 반환되어야 합니다.
GET {{baseUrl}}/api/v1/users/{{profileUserId}}/following?page=-1&size=10

###
# @name 8. Followers 목록 조회 실패 - 페이지 크기 초과
# size가 최대 크기 50을 초과하므로 400-8 응답이 반환되어야 합니다.
GET {{baseUrl}}/api/v1/users/{{profileUserId}}/followers?page=0&size=51


# ============================================================================
# 관리자
# 원본: back/postman/admin.http
# ============================================================================

# GameLog - Admin API
# IntelliJ IDEA HTTP Client에서 각 요청 왼쪽의 실행 버튼을 눌러 테스트합니다.
# 관리자 전용 회원가입 API는 따로 없습니다 - 회원가입은 모두 동일한 signup 엔드포인트를 쓰고,
# ADMIN 여부는 가입 후 DB에서 role 컬럼을 SQL로 바꿔야만 부여됩니다 (승격 API는 이미 ADMIN인
# 사람만 호출 가능하므로, 최초 1명은 반드시 이 수동 SQL 단계를 거쳐야 합니다).
#
# 순서: 1~2번(회원가입) -> DB에서 adminEmail 계정만 SQL로 role='ADMIN' 변경 -> 3번(로그인)부터 순서대로 실행
#   UPDATE users SET role='ADMIN' WHERE email='{{adminEmail}}';
# targetUserId는 승격 테스트 대상으로 쓸 일반 USER 계정의 id로 맞춰주세요 (userEmail로 가입한 계정의 id).

@adminEmail = admintest@test.com
@adminPassword = test1234!
@userEmail = usertest@test.com
@userPassword = test1234!
@targetUserId = 2

###
# @name signupAdminCandidate
# 1. admin으로 승격시킬 계정 회원가입 (일반 signup과 동일한 API) - 가입 직후 role은 USER
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "nickname": "admintest",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
# @name signupTargetUser
# 2. 승격 테스트 대상이 될 일반 USER 계정 회원가입
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "nickname": "usertest",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

> {%
    if (response.status === 200) {
        client.global.set("targetUserId", response.body.data.id);
        client.log("targetUserId 저장 완료: " + response.body.data.id);
    }
%}

###
# @name loginAsAdmin
# 3. admin 계정 로그인 및 accessToken 저장 (사전에 role='ADMIN'으로 세팅되어 있어야 함)
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    if (response.status === 200) {
        client.global.set("adminAccessToken", response.body.data.accessToken);
        client.log("adminAccessToken 저장 완료");
    } else {
        client.log("admin 로그인 실패: " + response.status);
    }
%}

###
# @name loginAsUser
# 4. 일반 USER 계정 로그인 및 accessToken 저장 (권한 없는 호출 검증용)
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

> {%
    if (response.status === 200) {
        client.global.set("userAccessToken", response.body.data.accessToken);
        client.log("userAccessToken 저장 완료");
    } else {
        client.log("user 로그인 실패: " + response.status);
    }
%}

###
# @name promoteToAdmin
# 5. admin 토큰으로 targetUserId를 ADMIN으로 승격 - 200 기대
PATCH {{baseUrl}}/api/v1/admin/users/{{targetUserId}}/role
Authorization: Bearer {{adminAccessToken}}

###
# @name rejectPromoteWithoutAdminRole
# 6. [실패 검증] 일반 USER 토큰으로 승격 시도 - 403 기대
PATCH {{baseUrl}}/api/v1/admin/users/{{targetUserId}}/role
Authorization: Bearer {{userAccessToken}}

###
# @name rejectPromoteWithoutToken
# 7. [실패 검증] 토큰 없이 승격 시도 - 401/403 기대
PATCH {{baseUrl}}/api/v1/admin/users/{{targetUserId}}/role

###
# @name getReviewReportsAsAdmin
# 8. admin 토큰으로 리뷰 신고 목록 조회 - 200 기대
GET {{baseUrl}}/api/v1/admin/review-reports?page=0&size=20
Authorization: Bearer {{adminAccessToken}}

###
# @name rejectReviewReportsAsUser
# 9. [실패 검증] 일반 USER 토큰으로 리뷰 신고 목록 조회 - 403 기대
GET {{baseUrl}}/api/v1/admin/review-reports?page=0&size=20
Authorization: Bearer {{userAccessToken}}

###
# @name promotedUserMustReloginNote
# 10. 참고: targetUserId 계정이 방금 승격됐다면, 그 계정 자신의 기존 access token은
# 여전히 role=USER 클레임을 갖고 있습니다. targetUserId로 admin 기능을 테스트하려면
# targetUserId 계정으로 재로그인(재발급)해서 새 accessToken을 받은 뒤 테스트하세요.

