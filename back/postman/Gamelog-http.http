# Gamelog - User Auth Copy

###
# @name 1. 회원가입
POST {{baseUrl}}/api/v1/users/signup
Content-Type: application/json

{
  "nickname": "테스트유저",
  "email": "test@test.com",
  "password": "12345678"
}

###
# @name 2. 로그인
POST {{baseUrl}}/api/v1/users/login
Content-Type: application/json

{
  "email": "test@test.com",
  "password": "12345678"
}

> {%
    if (response.status === 200) {
        const res = response.body;
        client.global.set("accessToken", res.data.accessToken);
        console.log("accessToken 저장됨:", res.data.accessToken);
    } else {
        console.log("로그인 실패:", response.body);
    }
%}

###
# @name 3. 토큰 재발급
# refreshToken 쿠키가 자동으로 전송됩니다 (2번 로그인 요청을 먼저 실행해서 쿠키가 저장되어 있어야 함). Postman 쿠키 자동 전송 설정이 켜져 있어야 합니다.
POST {{baseUrl}}/api/v1/users/refresh

> {%
    if (response.status === 200) {
        const res = response.body;
        client.global.set("accessToken", res.data.accessToken);
        console.log("accessToken 갱신됨:", res.data.accessToken);
    } else {
        console.log("재발급 실패:", response.body);
    }
%}

###
# @name 게임 정보
GET {{baseUrl}}/api/v1/games/1

### 라이브러리 api
###
# @name 게임 기록 수정
PATCH {{baseUrl}}/api/v1/library/games/1?
    userId=1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "playStatus": "PLAYED",
  "isPlaying": false,
  "isBacklog": false,
  "isWishlist": false,
  "isLiked": false,
  "platformId": 1,
  "playTimeHours": 42.5,
  "finishTimeHours": 35.0,
  "masterTimeHours": 80.0,
  "startedAt": "2026-08-01",
  "completedAt": "2026-08-20",
  "lastPlayedAt": "2026-08-20T21:30:00"
}

###
# @name 라이브러리에 추가
POST {{baseUrl}}/api/v1/library/games/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "playStatus": "PLAYED",
  "isPlaying": false,
  "isBacklog": false,
  "isWishlist": false,
  "isLiked": false,
  "platformId": 1,
  "playTimeHours": 42.5,
  "finishTimeHours": 35.0,
  "masterTimeHours": 80.0,
  "startedAt": "2026-08-01",
  "completedAt": "2026-08-20",
  "lastPlayedAt": "2026-08-20T21:30:00"
}

###
# @name 플레이 상태 변경
PUT http://localhost:8080/api/v1/library/games/1/play-status?status=PLAYED
Authorization: Bearer {{accessToken}}
Content-Type: application/x-www-form-urlencoded

###
# @name 플레이 중 변경
PATCH http://localhost:8080/api/v1/library/games/1/playing?playing=true
Authorization: Bearer {{accessToken}}
Content-Type: application/x-www-form-urlencoded

###
# @name 위시리스트 변경
PATCH http://localhost:8080/api/v1/library/games/1/wishlist?wishlist=false
Authorization: Bearer {{accessToken}}
Content-Type: application/x-www-form-urlencoded

###
# @name 백로그 변경
PATCH http://localhost:8080/api/v1/library/games/1/backlog?backlog=true
Authorization: Bearer {{accessToken}}
Content-Type: application/x-www-form-urlencoded

###
# @name 좋아요 변경
PATCH http://localhost:8080/api/v1/library/games/1/liked?liked=true
Authorization: Bearer {{accessToken}}
Content-Type: application/x-www-form-urlencoded

###